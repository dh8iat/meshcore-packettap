<service>
  <id>MeshCorePacketTapImporter</id>
  <name>MeshCore PacketTap Importer</name>
  <description>MeshCore PacketTap Importer to DEV QuestDB</description>

  <env name="PYTHONIOENCODING" value="utf-8"/>
  <env name="PYTHONUTF8" value="1"/>

  <executable>C:\PATH\TO\python.exe</executable>
  <arguments>-u C:\meshcore-packettap\packettap_importer.py --follow --questdb-host YOUR_QUESTDB_HOST --questdb-port 9000</arguments>

  <workingdirectory>C:\meshcore-packettap</workingdirectory>

  <startmode>Manual</startmode>

  <depend>MeshCorePacketTapReceiver</depend>

  <logpath>C:\meshcore-packettap\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>

  <onfailure action="restart" delay="10 sec"/>
</service>